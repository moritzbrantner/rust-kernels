{
  "schemaVersion": 1,
  "suite": "rust-kernels",
  "description": "Deterministic performance contracts for representative kernel workloads. Blocking evidence uses operation or instruction counts; ordinary shared-runner wall-clock timings remain informational.",
  "scenarios": [
    {
      "id": "radix-sort-4096",
      "kind": "micro",
      "description": "Sort 4,096 deterministic u32 values with radix_sort_u32.",
      "dimensions": {
        "items": 4096,
        "valueBits": 32
      },
      "correctnessEvidence": [
        "crates/search-kernels/benches/performance_smoke.rs::radix_4096",
        "search-kernels correctness tests"
      ],
      "metrics": [
        {
          "name": "callgrind-ir",
          "unit": "instructions",
          "direction": "lower",
          "signal": "instruction-count",
          "blocking": true,
          "budget": {
            "relativeRegressionPercent": 5
          }
        }
      ]
    },
    {
