  "operations": [
    {
      "id": "fenwick-linear-build",
      "description": "Construct a Fenwick tree with the explicitly regrouped from_slice_linear builder over CountingValue items.",
      "publicContract": "collection_kernels::FenwickTree::from_slice_linear",
      "dimensions": {
        "items": {
          "description": "values passed to the builder"
        }
      },
      "scalePoints": [
        {
          "items": 64
        },
        {
          "items": 128
        },
        {
          "items": 256
        },
        {
          "items": 512
        },
        {
          "items": 1024
        },
        {
          "items": 2048
        },
        {
          "items": 4096
        }
      ],
      "metrics": [
        {
          "name": "add-assign-operations",
          "unit": "operations",
          "signal": "operation-count",
          "budget": {
            "max": 8191
          },
          "notes": "Exactly 2n - popcount(n) AddAssign calls (2n - 1 at these powers of two), asserted per scale point in crates/collection-kernels/tests/work_complexity.rs together with a non-increasing marginal-work check. No growth bound is declared: the shared linear bound v(x) * x0 <= v(x0) * x rejects affine counts with a negative fixed term such as 2n - 1, so the budget at 4096 items carries the contract until coding-tooling has a vocabulary for it."
        }
      ]
    },
