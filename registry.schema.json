{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./registry.schema.json",
  "title": "rust-kernels registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "name",
    "version",
    "source",
    "provenance",
    "items"
  ],
  "properties": {
    "$schema": {
      "const": "./registry.schema.json"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": 3
    },
    "description": {
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revisionType"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "revisionType": {
          "const": "git-commit"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "lockFile"
      ],
      "properties": {
        "schema": {
          "const": "https://raw.githubusercontent.com/moritzbrantner/rust-kernels/main/provenance.schema.json"
        },
        "lockFile": {
          "const": ".rust-kernels.lock.json"
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "title",
        "description",
        "files"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "type": {
          "enum": [
            "registry:crate",
            "registry:algorithm",
            "registry:data-structure",
            "registry:file"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "crate": {
          "$ref": "#/$defs/crate"
        },
        "integration": {
          "$ref": "#/$defs/integration"
        },
        "characteristics": {
          "$ref": "#/$defs/characteristics"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "registryDependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "provides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/providedKernel"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "registry:crate"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "crate"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "integration"
                  ]
                },
                {
                  "required": [
                    "characteristics"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "integration",
              "characteristics",
              "verification"
            ],
            "not": {
              "required": [
                "crate"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "integration": {
                "properties": {
                  "mode": {
                    "const": "standalone-module"
                  }
                },
                "required": [
                  "mode"
                ]
              }
            },
            "required": [
              "integration"
            ]
          },
          "then": {
            "properties": {
              "files": {
                "maxItems": 1
              }
            }
          }
        }
      ]
    },
    "crate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "manifest"
      ],
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1
        },
        "manifest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "module"
      ],
      "properties": {
        "mode": {
          "const": "standalone-module"
        },
        "module": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$"
        }
      }
    },
    "characteristics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministic",
        "operations"
      ],
      "properties": {
        "deterministic": {
          "type": "boolean"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/operationCharacteristics"
          }
        }
      }
    },
    "operationCharacteristics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "time",
        "extraSpace",
        "mutation",
        "allocation"
      ],
      "properties": {
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "time": {
          "type": "string",
          "minLength": 1
        },
        "extraSpace": {
          "type": "string",
          "minLength": 1
        },
        "mutation": {
          "enum": [
            "none",
            "input",
            "internal-state"
          ]
        },
        "allocation": {
          "enum": [
            "none",
            "fixed",
            "input-sized",
            "capacity-bounded",
            "may-grow"
          ]
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tests",
        "benchmarks"
      ],
      "properties": {
        "tests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePathString"
          }
        },
        "benchmarks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePathString"
          }
        }
      }
    },
    "relativePathString": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "(^/|(^|/)\\.\\.(/|$))"
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "target"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "providedKernel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "symbols"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "type": {
          "enum": [
            "algorithm",
            "data-structure",
            "interface"
          ]
        },
        "symbols": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
