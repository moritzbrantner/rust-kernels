{
  "schemaVersion": 1,
  "profile": "repository-foundation-v1",
  "tiers": {
    "fast": ["format:check", "lint", "build", "test:unit"],
    "full": [
      "format:check",
      "lint",
      "build",
      "test:unit",
      "test:integration",
      "benchmark:smoke"
    ],
    "integration": ["test:integration"],
    "performance": ["benchmark:smoke", "benchmark"]
  },
  "requiredCapabilities": ["format:check", "lint", "build", "test:unit"],
  "optionalCapabilities": ["test:integration", "benchmark:smoke", "benchmark"],
  "capabilityCommands": {
    ".": {
      "benchmark": ["cargo", "bench", "-p", "search-kernels", "--bench", "search"],
      "benchmark:smoke": ["bash", "scripts/benchmark-smoke.sh"]
    }
  }
}
